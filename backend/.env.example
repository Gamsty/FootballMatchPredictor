# Football Match Predictor — Environment Variables
# Copy this file to .env and fill in your values.
# In production, these come from Azure Key Vault via managed-identity secret refs.

# --- Required ---

# PostgreSQL database connection string
DATABASE_URL=postgresql://username:password@localhost:5432/football_predictor

# API key from https://www.football-data.org/ (free tier: 10 req/min)
FOOTBALL_API_KEY=your_api_key_here

# --- Optional ---

# The Odds API key — enables /api/value-bets (+EV detection vs bookmaker odds).
# Free tier at https://the-odds-api.com/ — 500 requests/month.
# Without this set, the Value tab shows a "not configured" notice and the rest
# of the app continues to work normally.
ODDS_API_KEY=

# Shared secret for admin endpoints (/api/admin/reload-model, /api/fixtures/refresh,
# /api/admin/odds-refresh, etc.). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELOAD_TOKEN=

# Shared secret gating bet WRITES (POST /api/bets, POST /api/bets/combo,
# DELETE /api/bets/<id>, POST /api/admin/odds-refresh). Read endpoints stay
# public. Without this set, writes are unauthenticated — fine for local dev,
# REQUIRED in prod. Frontend stores it in localStorage via ?bet_token=<value>
# on the URL, then attaches it as X-Bet-Token on mutations.
BET_WRITE_TOKEN=

# External-data tuning.
# ODDS_API_FETCH_DEADLINE caps one fetch_odds call (retries and backoff included)
# so a bad upstream day can't stack per-league retries past gunicorn's timeout.
# FOOTBALL_API_DELAY is the spacing between football-data.org calls (free tier is
# 10/min). EXTERNAL_CSV_MAX_AGE_DAYS is how stale the CURRENT season's
# football-data.co.uk CSV may get before the loader re-downloads it; completed
# seasons are never re-fetched.
# ODDS_API_FETCH_DEADLINE=25
# FOOTBALL_API_DELAY=6
# FOOTBALL_API_TIMEOUT=20
# EXTERNAL_CSV_MAX_AGE_DAYS=3

# Odds API cache tuning. The client persists fetches to backend/data/odds_cache.json
# so cold-starts don't burn quota. Defaults to a 7-day TTL — override here in dev
# if you need fresher prices (e.g. 3600 = 1 hour). Path is also configurable for
# read-only filesystems or shared-volume setups.
# ODDS_API_CACHE_TTL=604800
# ODDS_API_CACHE_FILE=/app/data/odds_cache.json
# ODDS_API_QUOTA_FLOOR=20

# api-football.com (api-sports.io) API key — fetches fixtures for leagues not in
# football-data.org's free tier (currently used for Eliteserien).
# Free signup at https://dashboard.api-football.com/register (100 reqs/day).
# Used by backend/jobs/refresh_eliteserien.py. Optional — without it Eliteserien
# fixtures just don't get synced.
API_FOOTBALL_KEY=

# How many matches a club must have played before this season's league table is
# taken at face value. Below it, position is seeded from the previous season's
# final table — on matchday 1 every club is level and the table's ordering is an
# artefact of primary keys. Only position is seeded; points and goal difference
# stay at their true current values.
# EARLY_SEASON_MATCHES=5

# Bet-settlement tuning.
# POSTPONE_VOID_AFTER_HOURS: how long a POSTPONED/SUSPENDED fixture may sit
# before bets on it are voided. football-data.org reschedules the same match row
# rather than creating a new one, so voiding on sight closes bets at zero that
# would have been graded a few days later. CANCELLED always voids immediately.
# DUPLICATE_BET_WINDOW_SECONDS: window in which an identical bet (same match,
# market, outcome, price and stake) is rejected with 409 instead of written
# twice — guards against a double-clicked Log button. Set 0 to disable.
# POSTPONE_VOID_AFTER_HOURS=72
# DUPLICATE_BET_WINDOW_SECONDS=120

# Fewest distinct probabilities an isotonic calibrator must be able to emit per
# class before the API will use it. Isotonic is a step function; fit on too few
# samples it quantises the model's output so coarsely that different fixtures
# produce identical probabilities and edges stop meaning anything. Below this,
# the API logs a warning and serves uncalibrated instead. Temperature scaling
# (calibrator.json) is preferred and is not subject to this check.
# MIN_CALIBRATOR_RESOLUTION=50

# Build identity. Set by the deploy workflow to the commit sha the image was
# built from and reported at /api/health and /api/health/ready as `version`; the
# deploy smoke test requires it to match the commit that triggered the run, so a
# health check answered by the previous revision can't pass. Leave unset locally.
# GIT_SHA=

# Flask environment (development or production).
# NOTE: with FLASK_ENV=production, an unset BET_WRITE_TOKEN blocks bet writes
# outright rather than allowing them — the fail-open path is dev-only.
FLASK_ENV=development

# --- Runtime tuning (all optional, defaults shown) ---

# Connection pool, per PROCESS. pool_size + max_overflow multiplied by gunicorn
# workers and replicas is the real connection count against Postgres — keep the
# product under the server's max_connections (~50 on Burstable B1ms).
# Ignored for sqlite URLs, which use a different pool implementation.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=300
# DB_POOL_TIMEOUT=10

# Cross-worker reload propagation. When one gunicorn worker reloads the model
# (POST /api/admin/reload-model), it stamps an epoch here and the others adopt it
# on their next request. In Azure this path is the Azure Files mount, so the
# signal reaches every replica; locally it defaults to backend/data/.
# RELOAD_MARKER_FILE=/app/data/model_reload.json
# RELOAD_CHECK_INTERVAL=10

# Startup cache warming — runs on a background thread. Set WARM_CACHE=false to
# skip it entirely (tests, CLI runs); WARM_CACHE_LIMIT caps how many fixtures
# get precomputed so startup can't turn into a long inference job.
# WARM_CACHE=true
# WARM_CACHE_LIMIT=60

# Vercel team slug used to build the allowed preview-origin regex for CORS.
# Only change this if the Vercel team is renamed.
# VERCEL_OWNER_SLUG=gamstys-projects

# Frontend URL for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
